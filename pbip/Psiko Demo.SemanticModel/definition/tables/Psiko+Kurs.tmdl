table Psiko+Kurs
	lineageTag: be81b861-bc23-463c-8e0f-5079dbc720c1

	measure 'Gecikmiş (3 ay) Sayısı (Psiko)' = ```
			CALCULATE( COUNTROWS('Psiko+Kurs'), 
			'Psiko+Kurs'[Durum] = "Overdue")
			```
		formatString: 0
		lineageTag: 2374a9b7-558e-47b3-b9ca-af9c21439c84

	measure 'Şimdi (+1 ay) Sayısı (Psiko)' = ```
			CALCULATE( COUNTROWS('Psiko+Kurs'), 
			'Psiko+Kurs'[Durum] = "Due now")
			```
		formatString: 0
		lineageTag: ac3d5fe6-7fb4-4417-a4d4-7ed7a570ab20

	measure 'Yaklaşan (1-3 ay) Sayısı (Psiko)' = ```
			CALCULATE( COUNTROWS('Psiko+Kurs'), 
			'Psiko+Kurs'[Durum] = "Upcoming")
			```
		formatString: 0
		lineageTag: fd5e703a-59de-4b1f-8b3e-29371b7028b1

