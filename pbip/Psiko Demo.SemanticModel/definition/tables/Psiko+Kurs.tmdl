	column Kaynak
		dataType: string
		lineageTag: bf941304-277c-48f9-a569-dfc534877c15
		summarizeBy: none
		sourceColumn: Kaynak

		annotation SummarizationSetBy = Automatic

	column Durum =
			
			VAR _Fark = DATEDIFF(TODAY(), 'Psiko+Kurs'[Sıradaki Test], MONTH)
			RETURN
			    SWITCH(
			        TRUE(),
			        DATE(1968,01,01) = 'Psiko+Kurs'[TARİH], "Not Interested",
			        'Psiko+Kurs'[TARİH] < DATE(2021,06,30) , "Out of context",
			        _Fark < 0 && _Fark >=-3,   "Overdue",
			        _Fark <= 1 && _Fark >= 0,  "Due Now",
			        _Fark <= 3 && _Fark > 1,  "Upcoming",
			        "Later"
			    )
		lineageTag: 3051e95e-f546-435e-8267-a1b060623c9f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Sıradaki Test' =
			
			VAR _Bugun = TODAY()
			VAR _Capa = 'Psiko+Kurs'[TARİH]
			VAR _Esik = EDATE(_Bugun, -4)   -- 4 ay öncesine kadar geri bak
			RETURN
			    SWITCH(
			        TRUE(),
			        EDATE(_Capa, 60)  >= _Esik, EDATE(_Capa, 60),
			        EDATE(_Capa, 120) >= _Esik, EDATE(_Capa, 120),
			        EDATE(_Capa, 180) >= _Esik, EDATE(_Capa, 180),
			        EDATE(_Capa, 240) >= _Esik, EDATE(_Capa, 240),
			        EDATE(_Capa, 300)
			    )
		formatString: Short Date
		lineageTag: 0890d7a7-f453-41fa-bc2c-f4f69e9b6720
		summarizeBy: none

		variation Variation
			isDefault
			relationship: bc38d174-063e-44f8-b873-b42b89370f4e
			defaultHierarchy: LocalDateTable_aafd79ed-fee4-4a88-9822-607fa0f2414b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column ADI
		dataType: string
		lineageTag: ca729bdc-e08e-43b6-b5b3-6811b9c6a449
		summarizeBy: none
		sourceColumn: ADI

		annotation SummarizationSetBy = Automatic

	partition Psiko+Kurs = m
