	column 'Month Diff from Today'
		formatString: 0
		lineageTag: 64cf396a-5615-42cb-b290-3be8d3d4f299
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Diff from Today]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				VAR _StartDate = DATE(2010, 1, 1)
				VAR _EndDate   = DATE(2035, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(_StartDate, _EndDate),
				    "Yıl",                YEAR([Date]),
				    "Ay No",              MONTH([Date]),
				    "Ay",                 FORMAT([Date], "MMMM", "en-US"),
				    "Ay Kısa",            FORMAT([Date], "MMM", "en-US"),
				    "Ay Yıl",             FORMAT([Date], "MMM yyyy", "en-US"),
				    "Yıl-Ay (Sıralama)",  YEAR([Date]) * 100 + MONTH([Date]),
				    "Çeyrek",             "Q" & FORMAT([Date], "Q"),
				    "Yıl Çeyrek",         FORMAT([Date], "yyyy") & " Q" & FORMAT([Date], "Q"),
				    "Hafta Günü No",      WEEKDAY([Date], 2),
				    "Hafta Günü",         FORMAT([Date], "dddd", "en-US"),
				    "Past/Future",        SWITCH(TRUE(),
				                              [Date] < TODAY(), "Past",
				                              [Date] = TODAY(), "Today",
				                              "Future"),
				    "Is This Month",      IF(YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()), "Yes", "No"),
				    "Is This Year",       IF(YEAR([Date]) = YEAR(TODAY()), "Yes", "No"),
				    "Month Diff from Today", DATEDIFF(TODAY(), [Date], MONTH)
				)

	annotation PBI_Id = 1ed1233c69744c0498556755b2c93697

