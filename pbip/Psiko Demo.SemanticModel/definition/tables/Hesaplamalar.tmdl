table Hesaplamalar
	lineageTag: 2965f31d-7537-4de4-a6a9-2ea537adf610

	measure 'Due (+1 Month)' = ```
			CALCULATE( COUNTROWS('2010-2025 Kursiyer Listesi'), 
			'2010-2025 Kursiyer Listesi'[Status] = "Due now", 
			'2010-2025 Kursiyer Listesi'[SERTİFİKA] IN {"C", "CE", "D", "E"})
			```
		formatString: 0
		lineageTag: 71032829-d27d-41a5-a8bf-82e141e1b691

